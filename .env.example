# Copy to .env and fill in. In production set these as real environment variables.
# config.py reads env first, so these override the in-code defaults.

# Groq LLM — used ONLY at call end (summary + outcome). Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Storage backend:
#   - leave DATABASE_URL empty  → local file backend (dev / tests)
#   - set it                    → Postgres + pgvector (concurrency + scale)
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@localhost:5432/langmem
EMBED_DIM=768
LANG_MEMORY_DIR=./data/lang_memory

# PII encryption (REQUIRED in production). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LANG_MEMORY_ENC_KEY=
RETENTION_DAYS=0      # 0 = keep forever; e.g. 365 to auto-purge after a year
